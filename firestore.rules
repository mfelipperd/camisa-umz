rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /orders/{orderId} {
      // Public can create orders
      allow create: if true;
      
      // Public can read ONLY approved or delivered orders (for the buyers list)
      allow read: if resource.data.status in ['approved', 'delivered'];
      
      // Writing/Updating/Deleting is restricted (use Admin SDK or Cloud Functions)
      allow update, delete: if false;
    }
    
    match /config/{docId} {
      allow read: if true;
      allow write: if false;
    }
    
    match /batches/{batchId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
