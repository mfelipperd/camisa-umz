rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /orders/{orderId} {
      // Public can only create orders
      allow create: if true;
      // Reading/Updating is restricted to specific needs 
      // (Admin dashboard uses Admin SDK or we should ideally use Auth)
      // For now, disabling public read to protect customer info
      allow read, update, delete: if false;
    }
    
    match /config/{docId} {
      allow read: if true;
      allow write: if false;
    }
    
    match /batches/{batchId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
